# Keep the codebase consistent without a formatter dependency: .NET 4.0 means
# no dotnet-format, no Roslyn analyzers, no NuGet. This file is the whole
# tooling story for style.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.{ico,png,wav}]
insert_final_newline = false
